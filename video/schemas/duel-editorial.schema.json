{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Texte éditorial Pépite — duel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hook",
    "left_line",
    "right_line",
    "question",
    "caption",
    "hashtags"
  ],
  "properties": {
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70
    },
    "left_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "right_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "hashtags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^#[A-Za-z0-9À-ÖØ-öø-ÿ_]+$",
        "maxLength": 40
      }
    }
  }
}
